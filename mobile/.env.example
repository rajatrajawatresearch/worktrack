# Base URL for the WorkTrack backend API (must include the /api/v1 suffix).
# The mobile app reads this at build/start time via process.env.EXPO_PUBLIC_API_BASE_URL.
#
# Use your machine's LAN IP so a physical device / simulator can reach the backend.
#   - Physical device on same Wi-Fi: http://192.168.x.x:8000/api/v1  (replace with your machine IP)
#   - Android emulator:              http://10.0.2.2:8000/api/v1
#   - iOS simulator (same machine):  http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1

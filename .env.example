# ==========================================================
# WorkTrack — Environment Variables (example)
# Copy to .env and fill real values. NEVER commit .env.
# ==========================================================

# ---- Environment ----
# development | staging | production
ENVIRONMENT=development

# ---- Database ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://worktrack:worktrack@postgres:5432/worktrack

# Individual pieces used by docker-compose to init the postgres container
POSTGRES_USER=worktrack
POSTGRES_PASSWORD=worktrack
POSTGRES_DB=worktrack

# ---- JWT / Auth ----
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS ----
# Comma separated list of allowed origins for the admin web app.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Attendance policy defaults (can be overridden per-company) ----
DEFAULT_ALLOWED_RADIUS_METERS=150
MAX_ACCEPTABLE_ACCURACY_METERS=100
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Login rate limiting ----
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---- Initial super admin (used by seed script only) ----
SUPERADMIN_EMAIL=superadmin@worktrack.local
SUPERADMIN_PASSWORD=ChangeMe123!

# ---- Admin web (Vite) — put in admin/.env ----
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Mobile (Expo) — put in mobile/.env ----
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
